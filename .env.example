# Public canonical URL used for metadata, redirects, checkout, and reveal links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL database. Use Supabase or Neon in hosted environments.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dejabooom?schema=public

# OpenAI server-side recommendation generation. Never expose this key to the client.
OPENAI_API_KEY=sk-proj_replace_me
OPENAI_RECOMMENDATION_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=30000

# Stripe hosted checkout and signed webhooks.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Planning service products. Amounts are in cents for PLANNING_SERVICE_CURRENCY.
PLANNING_SERVICE_CURRENCY=usd
AI_SURPRISE_TRIP_NAME=AI Surprise Trip
AI_SURPRISE_TRIP_PRICE_CENTS=4900
CONCIERGE_SURPRISE_TRIP_NAME=Concierge Surprise Trip
CONCIERGE_SURPRISE_TRIP_PRICE_CENTS=14900

# Resend transactional email.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Dejabooom <hello@dejabooom.com>
ADMIN_ALERT_EMAIL=ops@dejabooom.com

# Simple operator admin protection for /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_password

# Private reveal token storage. Generate a 32-byte base64 key:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REVEAL_TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64_key
REVEAL_TOKEN_TTL_DAYS=30

# Durable recommendation worker. Vercel Cron sends this value as a Bearer token.
CRON_SECRET=replace_with_a_long_random_secret
RECOMMENDATION_JOB_BATCH_SIZE=1

# Optional scoring override. Values are normalized automatically.
RECOMMENDATION_WEIGHTS_JSON={"interestMatch":0.3,"budgetFit":0.2,"travelStyleMatch":0.15,"novelty":0.1,"logistics":0.1,"climateMatch":0.1,"durationFit":0.05}
